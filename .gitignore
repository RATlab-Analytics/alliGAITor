.gitignore

# OS
.DS_Store

# Python
__pycache__/
*.pyc

# SLEAP projects and predictions
*.slp
/predictions/

# Trained models (large binaries)
/models/

# Skeleton definitions
skeleton.json
minimal_skeleton.json

# Raw and cropped training video data
/videos/

# One-off developer/debug scripts
/tools/crop_tool_main.py
/tools/make_video_split.py
/scripts

# Pipeline outputs and raw calibration recordings (large; calibration.toml
# itself is small and worth tracking once it exists)
/predictions_3d/
/calibration/*.mp4
/calibration/*.mov
